{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "baseUrl": "/opt/homebrew/lib/node_modules/@earendil-works",
    "paths": {
      "@earendil-works/pi-coding-agent": ["pi-coding-agent/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
      "@earendil-works/pi-tui": ["pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
      "typebox": ["pi-coding-agent/node_modules/typebox/build/index.d.mts"]
    }
  },
  "include": ["index.ts", "client.ts"]
}